{
	"extends": "./config/typescript/base.json",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.cache/pi-stuff/typecheck/root.tsbuildinfo"
	},
	"include": ["scripts/**/*.ts", "tests/**/*.ts", "tools/**/*.ts", "packages/pi-stuff/src/**/*.ts"],
	"exclude": [
		"node_modules",
		".artifacts",
		"packages/pi-stuff/src/subagents/**",
		"packages/pi-stuff/src/rtk/**",
		"tests/agents",
		"tests/rtk",
		"tests/*/subagents/**",
		"tests/*/rtk/**"
	]
}
